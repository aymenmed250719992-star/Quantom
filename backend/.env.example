# ═══════════════════════════════════════════════════════
#  Islamic Trading Bot — Environment Variables
#  Copy to .env and fill in your values (backend/ folder)
#  NEVER commit .env to git
# ═══════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────
# Render PostgreSQL (auto-injected by render.yaml)
DATABASE_URL=postgresql://user:password@host:5432/trading_bot

# Optional: Supabase as alternative DB (takes priority over DATABASE_URL)
# SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── AI Keys (add at least one for full functionality) ────
GEMINI_API_KEY=          # Free at aistudio.google.com — up to 10 keys supported
GROQ_API_KEY=            # Free at console.groq.com — llama-3.3-70b
OPENAI_API_KEY=          # Optional
ANTHROPIC_API_KEY=       # Optional

# ── CEX Exchange ─────────────────────────────────────────
EXCHANGE_NAME=mexc
EXCHANGE_MODE=demo       # demo | live
MEXC_API_KEY=
MEXC_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Unlock all exchanges (Render IPs are not blocked like some shared hosts)
CEX_ALLOW_ALL=true

# ── DEX / Blockchain ─────────────────────────────────────
DEX_NETWORK=base         # base | polygon | bsc
DEX_PRIVATE_KEY=         # Your wallet private key (for live DEX trading)
DEX_RPC_URL=             # Optional: Alchemy/Infura RPC URL
HYBRID_MODE=auto         # auto | dex_only | cex_only

# ── Bot Settings ─────────────────────────────────────────
MIN_CONFIDENCE_SCORE=55
MAX_RISK_PERCENT=1.5
TARGET_WIN_RATE=65
EXCHANGE_STRATEGY=auto
