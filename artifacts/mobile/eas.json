{
  "cli": {
    "version": ">= 18.13.0",
    "appVersionSource": "local"
  },
  "build": {
    "ci": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "YOUR_RENDER_APP.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "YOUR_RENDER_APP.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production-bundle": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
