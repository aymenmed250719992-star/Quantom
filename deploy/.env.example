# ── Database ────────────────────────────────────────────────────
# PostgreSQL connection URL (Render / Neon / Supabase / Oracle)
QUANTOM_DB_URL=postgresql://user:password@host:5432/dbname

# ── Cloudflare Tunnel ────────────────────────────────────────────
# Get this from: cloudflare.com → Zero Trust → Tunnels → Create Tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiXXXXXXXX...

# ── Server Domain (set after Cloudflare tunnel is running) ───────
# Example: quantom-bot.yourdomain.com  (no https://)
SERVER_DOMAIN=quantom-bot.yourdomain.com

# ── Trading Settings ─────────────────────────────────────────────
EXCHANGE_MODE=demo
MIN_CONFIDENCE_SCORE=55
MAX_RISK_PERCENT=1.5
TARGET_WIN_RATE=65.0
DEMO_BALANCE_USDT=10000

# ── AI Keys (optional — can be added via the app Settings screen) ─
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
